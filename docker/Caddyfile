{
  admin off
  auto_https off
}
:8080 {
  root * /srv
  encode zstd gzip
  import /etc/caddy/headers.caddy
  @unsupported not method GET HEAD
  respond @unsupported 405
  @hidden path /.*
  respond @hidden 404
  header Cache-Control "no-cache"
  @immutable path /_next/static/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  file_server
  handle_errors {
    rewrite * /404.html
    file_server
  }
}

